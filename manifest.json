{
	"manifest_version": 2.0,
	"id": "maintwin",
	"name": "Maintenance Windows",
	"namespace": "MaintWin",
	"version": "2.0.0",
	"author": "John Danhires",
	"description": "Paste or upload a list of hosts, verify them, and drop them all into a Zabbix maintenance window. Works for non-admin users via a scoped service token.",
	"actions": {
		"maintwin.view": {
			"class": "View",
			"view": "maintwin.view",
			"layout": "layout.htmlpage"
		},
		"maintwin.windows": {
			"class": "View",
			"view": "maintwin.view",
			"layout": "layout.htmlpage"
		},
		"maintwin.verify": {
			"class": "Verify",
			"layout": "layout.json"
		},
		"maintwin.create": {
			"class": "Create",
			"layout": "layout.json"
		},
		"maintwin.update": {
			"class": "Update",
			"layout": "layout.json"
		},
		"maintwin.list": {
			"class": "MaintList",
			"layout": "layout.json"
		},
		"maintwin.end": {
			"class": "End",
			"layout": "layout.json"
		}
	},
	"assets": {
		"css": ["maintwin.css"],
		"js": ["maintwin.js"]
	}
}
